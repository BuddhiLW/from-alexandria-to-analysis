;; alexandria: a curated library of historical mathematics.
;;
;; The objects of the historical texts (points, lines, circles, magnitudes,
;; constructions, propositions) as values, computed in any geometry CONTEXT
;; (a surface: Euclid's plane is one case), in any number BACKEND, and drawn
;; on any MEDIUM. Decks and Clerk notebooks import it; neither keeps a copy.
;;
;; See ARCHITECTURE.md for the strata and the extension rules.
{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.2"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.34"}
        ;; the construction engine, projective geometry, TeX: same sha the decks pin
        io.github.mentat-collective/desargues {:git/sha "f505297289bd4e002bb2b33d8f0cce154673362a"}
        ;; algebra, manifolds, numerics: the BuddhiLW fork the decks pin
        io.github.mentat-collective/emmy {:git/url "https://github.com/BuddhiLW/emmy.git"
                                          :git/sha "4960de45705f79a0183f429f32d7d5be8fa7af39"}
        ;; the numeric backend: desargues boards compile to raster kernels
        io.github.replikativ/raster {:git/tag "v0.2.258" :git/sha "d0fb8f7"}}

 :aliases
 {:test {:extra-paths ["test" "notebooks"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.11"}
                      io.github.nextjournal/clerk {:mvn/version "0.18.1158"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :notebooks {:extra-paths ["notebooks"]
              :extra-deps {io.github.nextjournal/clerk {:mvn/version "0.18.1158"}}
              :exec-fn alexandria.notebooks-build/build!
              :exec-args {:out-path "public/notebooks"}}

  ;; Adapters that need Emmy (the exact backend, general surfaces) live in
  ;; their own source root, so the core stays free of it. Same Emmy fork the
  ;; decks pin.
}}
