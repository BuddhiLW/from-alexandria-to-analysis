;; Eudoxus, as Euclid gives him: Elements V (proportion) and XII.2
;; (exhaustion). Statements from T. L. Heath, The Thirteen Books of
;; Euclid's Elements (1908), vol. 2 (V) and vol. 3 (XII).
{:tradition {:id :eudoxus/elements-5
             :author "Eudoxus"
             :work "Elements, Books V and XII (Eudoxus' theory)"
             :date "c. 350 BC"
             :source "T. L. Heath, The Thirteen Books of Euclid's Elements, 1908"}
 :propositions
 [{:id :eudoxus/V.def-5
   :title "V, Definition 5"
   :statement "Magnitudes are said to be in the same ratio, the first to the second and the third to the fourth, when, if any equimultiples whatever be taken of the first and third, and any equimultiples whatever of the second and fourth, the former equimultiples alike exceed, are alike equal to, or alike fall short of, the latter equimultiples respectively taken in corresponding order."
   :source "Heath 1908, vol. 2, p. 114"
   :construction
   {:id :eudoxus-side-diagonal
    :kind :construction
    :window {:x [-0.5 1.5] :y [-0.5 1.5] :n 1 :sweep [0 1]}
    :points [{:id :A :at [0.0 0.0] :fixed? true}
             {:id :B :at [1.0 0.0] :fixed? true}
             {:id :C :op :square-corner :side [:A :B] :turn :left :corner 0}
             {:id :D :op :square-corner :side [:A :B] :turn :left :corner 1}]
    :draw [[:segment :A :B] [:segment :B :C] [:segment :C :D] [:segment :D :A] [:segment :A :C]]
    :checks [{:claim (= (square (length A C)) (* 2 (square (length A B))))}]}}

  {:id :eudoxus/XII.2
   :title "XII.2"
   :statement "Circles are to one another as the squares on the diameters."
   :source "Heath 1908, vol. 3, p. 371"
   :construction
   {:id :eudoxus-XII-2
    :kind :construction
    :window {:x [-1.5 3.5] :y [-1.5 1.5] :n 1 :sweep [0 1]}
    :points [{:id :O :at [0.0 0.0] :fixed? true}
             {:id :P :at [1.0 0.0] :fixed? true}
             {:id :Q :op :square-corner :side [:O :P] :turn :left :corner 1}
             {:id :O2 :at [2.5 0.0] :fixed? true}
             {:id :P2 :at [3.1 0.0] :fixed? true}
             {:id :Q2 :op :square-corner :side [:O2 :P2] :turn :left :corner 1}]
    :draw [[:circle :O :P] [:circle :O2 :P2] [:segment :P :Q] [:segment :P2 :Q2]]
    :checks [{:claim (= (* (area O P Q) (square (length O2 P2))) (* (area O2 P2 Q2) (square (length O P))))}]}}]}
