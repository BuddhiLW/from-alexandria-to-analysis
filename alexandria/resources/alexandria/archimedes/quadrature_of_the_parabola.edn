;; Archimedes, Quadrature of the Parabola: propositions as a desargues construction.
;; Statement from T. L. Heath, The Works of Archimedes (1897).
;;
;; The equalities are :claim checks over alexandria.vocab's `area` (Euclid's
;; signed triangle area, desargues.board.euclid :area), not hand-expanded
;; shoelace :value expressions: each area is then built from the bound point
;; symbols, so no author expression holds more than a handful of them
;; (desargues.board.algebra/symbolic evals one fn param per symbol, and a JVM
;; fn takes at most 20).
{:tradition {:id :archimedes/quadrature-of-the-parabola
             :author "Archimedes"
             :work "Quadrature of the Parabola"
             :date "c. 250 BC"
             :source "T. L. Heath, The Works of Archimedes, 1897"}
 :propositions
 [{:id :archimedes/parabola-17-24
   :title "Propositions 17 and 24: the parabolic segment is four thirds of the triangle"
   :statement "Every segment bounded by a parabola and a chord is four thirds of the triangle which has the same base as the segment and equal height."
   :source "Heath 1897, pp. 251-252, 260-263"
   :construction
   {:id :archimedes/parabola-17-24
    :kind :construction
    :window {:x [-1.6 1.6] :y [-0.15 2.4] :n 193 :sweep [0 1]}
    :params [{:id ax :min -1.5 :max 0.5 :init -1.0 :label "A x"}
             {:id bx :min -0.5 :max 1.5 :init 1.0 :label "B x"}
             {:id k :min 1 :max 4 :init 3 :label "stages"}]
    :points [{:id :A :op :expr :x ax :y (* ax ax)}
             {:id :B :op :expr :x bx :y (* bx bx)}
             {:id :V :op :expr :x (/ (+ ax bx) 2) :y (* (/ (+ ax bx) 2) (/ (+ ax bx) 2))}
             {:id :L :op :expr :x (/ (+ ax (/ (+ ax bx) 2)) 2) :y (* (/ (+ ax (/ (+ ax bx) 2)) 2) (/ (+ ax (/ (+ ax bx) 2)) 2))}
             {:id :R :op :expr :x (/ (+ (/ (+ ax bx) 2) bx) 2) :y (* (/ (+ (/ (+ ax bx) 2) bx) 2) (/ (+ (/ (+ ax bx) 2) bx) 2))}
             {:id :LL :op :expr :x (/ (+ ax (/ (+ ax (/ (+ ax bx) 2)) 2)) 2) :y (* (/ (+ ax (/ (+ ax (/ (+ ax bx) 2)) 2)) 2) (/ (+ ax (/ (+ ax (/ (+ ax bx) 2)) 2)) 2))}
             {:id :LR :op :expr :x (/ (+ (/ (+ ax (/ (+ ax bx) 2)) 2) (/ (+ ax bx) 2)) 2) :y (* (/ (+ (/ (+ ax (/ (+ ax bx) 2)) 2) (/ (+ ax bx) 2)) 2) (/ (+ (/ (+ ax (/ (+ ax bx) 2)) 2) (/ (+ ax bx) 2)) 2))}
             {:id :RL :op :expr :x (/ (+ (/ (+ ax bx) 2) (/ (+ (/ (+ ax bx) 2) bx) 2)) 2) :y (* (/ (+ (/ (+ ax bx) 2) (/ (+ (/ (+ ax bx) 2) bx) 2)) 2) (/ (+ (/ (+ ax bx) 2) (/ (+ (/ (+ ax bx) 2) bx) 2)) 2))}
             {:id :RR :op :expr :x (/ (+ (/ (+ (/ (+ ax bx) 2) bx) 2) bx) 2) :y (* (/ (+ (/ (+ (/ (+ ax bx) 2) bx) 2) bx) 2) (/ (+ (/ (+ (/ (+ ax bx) 2) bx) 2) bx) 2))}
             {:id :P :op :expr :x (+ ax (* (- bx ax) u)) :y (* (+ ax (* (- bx ax) u)) (+ ax (* (- bx ax) u)))}]
    :draw [[:trace :P {:color :white}]
           [:segment :A :B {:color :white}]
           [:polygon [:A :V :B] {:color :yellow :fill-opacity 0.22}]
           [:polygon [:A :L :V] {:color :blue :fill-opacity 0.18}]
           [:polygon [:V :R :B] {:color :blue :fill-opacity 0.18}]
           [:polygon [:A :LL :L] {:color :green :fill-opacity 0.14}]
           [:polygon [:L :LR :V] {:color :green :fill-opacity 0.14}]
           [:polygon [:V :RL :R] {:color :green :fill-opacity 0.14}]
           [:polygon [:R :RR :B] {:color :green :fill-opacity 0.14}]
           [:point :A {:label "A"}]
           [:point :B {:label "B"}]
           [:point :V {:label "V"}]]
    :checks [{:area [:A :V :B] :predicate :positive :label "first triangle area reads A,V,B"}
             {:area [:A :L :V] :predicate :positive :label "left next triangle area reads A,L,V"}
             {:area [:V :R :B] :predicate :positive :label "right next triangle area reads V,R,B"}
             {:claim (= (+ (area A L V) (area V R B))
                        (* (/ 1 4) (area A V B)))
              :expected 0.0 :tolerance 1.0E-9
              :label "constructed next-generation triangles equal one fourth of ABV"}
             {:claim (= (+ (area A V B)
                           (area A L V) (area V R B)
                           (area A LL L) (area L LR V) (area V RL R) (area R RR B))
                        (* (area A V B) (+ 1 (/ 1 4) (/ 1 16))))
              :expected 0.0 :tolerance 1.0E-9
              :label "constructed stage 1..3 triangles match geometric sum"}
             {:claim (= (/ (* (- bx ax) (- bx ax) (- bx ax)) 6)
                        (* (/ 4 3) (area A V B)))
              :expected 0.0 :tolerance 1.0E-9
              :label "exact parabolic segment integral equals 4/3 of ABV read from points"}
             {:claim (= (/ (* (- bx ax) (- bx ax) (- bx ax)) 6)
                        (+ (area A V B)
                           (area A L V) (area V R B)
                           (area A LL L) (area L LR V) (area V RL R) (area R RR B)))
              :predicate :positive
              :label "constructed partial sums approach the segment area from below"}]}}]}
