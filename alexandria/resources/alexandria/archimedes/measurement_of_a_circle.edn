le"} {:area [:O :I0 :I1] :predicate :positive :label "one inscribed sector triangle area reads O,I0,I1"} {:distance [:I0 :I1] :predicate :positive :label "one inscribed side length reads I0,I1"}]}} {:id :archimedes/circle-3 :title "Proposition 3: bounds on Math/PI" :statement "The circumference of any circle exceeds three times the diameter by a part which is less than one-seventh of the diameter but more than ten seventy-firsts." :source "Heath 1897, pp. 93-98" :construction {:id :archimedes/circle-3 :kind :construction :window {:x [-1.35 1.35] :y [-1.35 1.35] :n 193 :sweep [0 1]} :params [{:id r :min 0.25 :max 2.0 :init 1.0 :label "radius"} {:id sides :min 6 :max 96 :init 96 :label "sides (6,12,24,48,96)"}] :points [{:id :O :at [0 0] :fixed? true} {:id :I0 :op :expr :x r :y 0} {:id :I1 :op :expr :x (* r (cos (/ (* 2 Math/PI) sides))) :y (* r (sin (/ (* 2 Math/PI) sides)))} {:id :J0 :op :expr :x (/ r (cos (/ Math/PI sides))) :y 0} {:id :J1 :op :expr :x (* (/ r (cos (/ Math/PI sides))) (cos (/ (* 2 Math/PI) sides))) :y (* (/ r (cos (/ Math/PI sides))) (sin (/ (* 2 Math/PI) sides)))} {:id :C :op :expr :x (* r (cos (* (* 2 Math/PI) u))) :y (* r (sin (* (* 2 Math/PI) u)))}] :draw [[:trace :C {:color :white}] [:segment :I0 :I1 {:color :yellow}] [:segment :J0 :J1 {:color :blue}] [:point :O {:label "O"}]] :checks [{:value (- (/ (* sides (sqrt (+ (* (- (x I1) (x I0)) (- (x I1) (x I0))) (* (- (y I1) (y I0)) (- (y I1) (y I0)))))) (* 2 r)) (/ 223 71)) :predicate :positive :label "inscribed perimeter/diameter from I0,I1 exceeds 223/71"} {:value (- (/ 22 7) (/ (* sides (sqrt (+ (* (- (x J1) (x J0)) (- (x J1) (x J0))) (* (- (y J1) (y J0)) (- (y J1) (y J0)))))) (* 2 r))) :predicate :positive :label "circumscribed perimeter/diameter from J0,J1 is less than 22/7"} {:value (- Math/PI (/ (* sides (sqrt (+ (* (- (x I1) (x I0)) (- (x I1) (x I0))) (* (- (y I1) (y I0)) (- (y I1) (y I0)))))) (* 2 r))) :predicate :positive :label "Emmy Math/PI above computed inscribed bound"} {:value (- (/