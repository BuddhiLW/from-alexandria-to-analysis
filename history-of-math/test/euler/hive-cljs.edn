;; hive-cljs manifest: browser check of the Euler notebook build.
;;
;;   cd history-of-math && clojure -J-Xmx2g -M:notebooks dev/build_euler.clj
;;   python3 -m http.server -d target/hom-euler 8093
;;   code {command: "cljs e2e run", directory: "<this dir>", tags: "euler"}
{:hive.cljs/toolchain :browser

 :hive.cljs/builds {:euler {:http-port 8093
                            :command ["clojure" "-J-Xmx2g" "-M:notebooks" "dev/build_euler.clj"]}}

 :hive.cljs/e2e
 {:base-url   "http://localhost:8093"
  :browser    :chromium
  :headless   true
  :timeout-ms 60000
  :scenarios
  [{:id    :euler-renders
    :tags  [:euler :smoke]
    :doc   "The notebook renders its sections, no badge reads FAILS, and the
            four players mount their SVG scenes."
    :steps [[:goto "/"]
            [:wait-for "h1"]
            [:wait-ms 6000]
            [:expect-js "document.body.innerText.indexOf('Euler\\'s argument, paragraph by paragraph') >= 0"]
            [:expect-js "document.body.innerText.indexOf('FAILS') < 0"]
            [:expect-js "document.body.innerText.indexOf('Reading the original') >= 0"]
            [:expect-js "document.querySelectorAll('svg').length >= 4"]]}

   {:id    :euler-player-steps
    :tags  [:euler]
    :doc   "Clicking a later step of the Koenigsberg player draws a scene
            (no 'no drawing for' fallback anywhere on the page)."
    :steps [[:goto "/"]
            [:wait-for "svg"]
            [:wait-ms 6000]
            [:expect-js "document.body.innerText.indexOf('no drawing for') < 0"]]}

   {:id    :euler-widgets-mount
    :tags  [:euler :widgets]
    :doc   "Every widget mounts on the raster backend: Basel, e, e^{ix}, E101
            ch. VII stepped, E230 stepped, the cut solid (MathBox canvas)."
    :steps [[:goto "/"]
            [:wait-for "[data-figure=\"euler-polyhedron\"]"]
            [:wait-ms 6000]
            [:expect-js "['euler-basel','euler-e','euler-cis','euler-base','euler-terms','euler-polyhedron'].every(id => document.querySelector('[data-figure=\"' + id + '\"]'))"]
            [:expect-js "document.querySelector('[data-figure=\"euler-polyhedron\"]').querySelectorAll('canvas').length >= 1"]]}

   {:id    :euler-cut-solid-named
    :tags  [:euler :widgets]
    :doc   "The cut solid starts as the cube named in Greek with V - E + F = 2;
            the e^{ix} point is named (x = 2: second quadrant)."
    :steps [[:goto "/"]
            [:wait-for "[data-figure=\"euler-polyhedron\"]"]
            [:wait-ms 6000]
            [:expect-js "document.querySelector('[data-figure=\"euler-polyhedron\"]').dataset.name.indexOf('κύβος') >= 0"]
            [:expect-js "document.querySelector('[data-figure=\"euler-polyhedron\"]').dataset.chi === '2'"]
            [:expect-js "document.querySelector('[data-figure=\"euler-cis\"]').dataset.name.indexOf('second quadrant') === 0"]]}]}}
